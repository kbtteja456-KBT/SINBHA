# Paste your OpenRouter API key below (without quotes)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Chosen AI Model on OpenRouter (affordable, warm, and fast)
OPENROUTER_MODEL=google/gemini-2.5-flash
PORT=8080
# Developer-only testing mode (default false; set to true to view developer memory inspector)
DEV_MODE=false

# Database Connection (Step 10: PostgreSQL)
# Example Cloud (e.g., Neon / Supabase): postgresql+psycopg://username:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Local Windows: postgresql+psycopg://postgres:your_password@localhost:5432/sinbha
# SQLite Quick Test Fallback (default if left blank): sqlite:///sinbha.db
DATABASE_URL=sqlite:///sinbha.db
