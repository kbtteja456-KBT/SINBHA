# ========================================================
# SINBHA Environment Configuration (.env.example)
# Never commit your actual .env file with real secrets!
# ========================================================

# 1. AI Model API Credentials (Groq 100% Free or OpenRouter)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# 2. Server Port & Mode
PORT=8080
# Set ENV=production on live servers.
# In production: DEV_MODE is forced off, cookies are Secure, SSL is required on PostgreSQL.
ENV=development
DEV_MODE=false

# 3. Database Connection (Neon PostgreSQL)
# Example: postgresql+psycopg://neondb_owner:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///sinbha.db

# 4. Encryption at Rest & Sessions
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=your_base64_fernet_key_here

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=your_random_session_secret_here

# 5. Trusted Web Origins (CORS & CSRF)
# Comma-separated list of additional trusted origins (e.g., https://your-app.onrender.com, tauri://localhost)
ALLOWED_ORIGINS=https://localhost,http://localhost:8000

# 6. Usage Caps & Friendly Kill Switch
DAILY_USER_AI_LIMIT=100
DAILY_GLOBAL_AI_LIMIT=2000

# 7. Real Web Search (Step 15: Tavily API)
# Get a free key at https://app.tavily.com (1,000 free searches/month)
TAVILY_API_KEY=your_tavily_api_key_here
