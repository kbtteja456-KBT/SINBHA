{
  "name": "sinbha-desktop",
  "version": "1.0.4",
  "description": "SINBHA - Personal Habit & Task Companion with Desktop Bird Overlay",
  "main": "electron/main.js",
  "author": "kbtteja456-KBT",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/check_secrets.js",
    "build:win": "npm run prebuild && electron-builder --win",
    "dist": "npm run build:win",
    "android:sync": "node scripts/check_secrets.js && npx cap sync android",
    "bump": "node scripts/bump_version.js",
    "android:check-version": "node scripts/check_version_code.js",
    "keystore:copy": "node scripts/copy_keystore.js",
    "android:open": "npx cap open android",
    "android:keystore": "node scripts/generate_keystore.js"
  },
  "build": {
    "appId": "com.sinbha.desktop",
    "productName": "SINBHA",
    "artifactName": "SINBHA-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "static/bird/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SINBHA",
      "uninstallDisplayName": "SINBHA Personal AI Companion",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "kbtteja456-KBT",
      "repo": "sinbha-releases",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "electron-updater": "^6.6.3"
  }
}
